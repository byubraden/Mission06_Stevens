@model List<Movie>

<table class="table table-bordered table-striped table-hover text-center shadow-lg rounded">
    <thead class="fw-bold table-dark">
    <tr>
        <td>Title</td>
        <td>Category</td>
        <td>Year</td>
        <td>Director</td>
        <td>Rating</td>
        <td>Edited</td>
        <td>Lent To</td>
        <td>Copied To Plex</td>
        <td>Notes</td>
        <td>Actions</td>
    </tr>
    </thead>
    <tbody>
    @foreach (var x in Model)
    {
        <tr>
            <td>@x.Title</td>
            <td>@(x.Category?.CategoryName ?? "NULL")</td>
            <td>@x.Year</td>
            <td>@x.Director</td>
            <td>@x.Rating</td>
            <td>@x.Edited</td>
            <td>@x.LentTo</td>
            <td>@x.CopiedToPlex</td>
            <td>@x.Notes</td>
            
            <td>
                <div class="d-flex gap-2">
                    <a class="btn btn-info btn-sm" asp-controller="Home" asp-action="EditMovie" asp-route-id="@x.MovieId">Edit</a>
                    <a class="btn btn-danger btn-sm" asp-controller="Home" asp-action="DeleteMovie" asp-route-id="@x.MovieId">Delete</a>
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>